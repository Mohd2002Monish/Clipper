{
  "expo": {
    "name": "Clip Ingest",
    "slug": "videotimmer",
    "owner": "mohd4monishs-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "clipqueue",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mohd4monish.videotimmer"
    },
    "android": {
      "package": "com.mohd4monish.videotimmer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      },
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-share-intent",
        {
          "package": "com.mohd4monish.videotimmer"
        }
      ],
      "./plugins/withInstagramClipper.js"
    ],
    "extra": {
      "eas": {
        "projectId": "76f66686-a54d-4740-9825-d2c60b4fae52"
      }
    }
  }
}
