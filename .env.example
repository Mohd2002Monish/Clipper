# Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Database & Queue
MONGODB_URI=mongodb://localhost:27017/videotimmer
REDIS_URL=redis://localhost:6379

# Storage & Paths
STORAGE_DIR=./storage
LOG_DIR=./logs
LOG_RETENTION_DAYS=7

# Processing Limits
MAX_UPLOAD_SIZE_MB=2048
MAX_PARTS_LIMIT=100
WORKER_CONCURRENCY=2

# Security & Encryption
ENCRYPTION_SECRET=your-32-character-secret-key-here-must-be-32-bytes!
AUTH_SECRET=videotimmer-dev-secret-key

# Google Drive API (Optional for local-only mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback
GOOGLE_DEFAULT_FOLDER_ID=

# Paths to binaries (defaults to system PATH if empty)
FFMPEG_PATH=
FFPROBE_PATH=

# Google Gemini AI API (For automatic timestamped speech-to-text subtitles)
GEMINI_API_KEY=

# Meta Threads API & OAuth (Optional)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/auth/threads/callback
